[Unit]
Description=WB Profit Firewall private dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wb-profit-firewall
Environment=NODE_ENV=production
Environment=PORT=3847
ExecStart=/usr/bin/node /opt/wb-profit-firewall/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/wb-profit-firewall/.data

[Install]
WantedBy=multi-user.target
